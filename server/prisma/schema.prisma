// server/prisma/schema.prisma
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // directUrl = env("DATABASE_URL_UNPOOLED") // opcional para conexiones sin pool
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  displayName  String?
  createdAt    DateTime @default(now())

  moods   Mood[]
  habits  Habit[]
  goals   Goal[]
}

model Mood {
  id      String   @id @default(cuid())
  user    User     @relation(fields: [userId], references: [id])
  userId  String
  date    DateTime @default(now())
  type    String   // previously enum; SQLite connector doesn't support Prisma enums
  note    String?
}

model Habit {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  title     String
  archived  Boolean  @default(false)
  logs      HabitLog[]
  goal      Goal?    @relation(fields: [goalId], references: [id])
  goalId    String?
  createdAt DateTime @default(now())
}

model HabitLog {
  id       String   @id @default(cuid())
  habit    Habit    @relation(fields: [habitId], references: [id])
  habitId  String
  date     DateTime @default(now())
  status   String   // e.g., DONE, SKIPPED
}

model Goal {
  id       String   @id @default(cuid())
  user     User     @relation(fields: [userId], references: [id])
  userId   String
  title    String
  dueDate  DateTime?
  status   String   // e.g., OPEN, DONE, CANCELED
  targetDays  Int?   // días necesarios para considerar el objetivo logrado
  completedAt DateTime?
  habits   Habit[]
  createdAt DateTime @default(now())
}
